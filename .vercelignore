# Flutter build output — build/web uploaded as outputDirectory
.dart_tool/

# Android/iOS/desktop platform builds — web only on Vercel
# NOTE: patterns are anchored with a leading / so they only match ROOT dirs,
# NOT build/web subfolders (unanchored "assets/" was excluding build/web/assets
# which broke translations/fonts and caused a blank screen on boot)
/android/
/ios/
/macos/
/windows/
/linux/

# Large development assets
.pub-cache/

# Git
.git/

# Misc
*.log
.DS_Store

# Stray zero-byte file that confuses Vercel Go framework detection
cmd

# Flutter source files — not needed, site is pre-built
/lib/
/test/
/assets/
/pubspec.yaml
/pubspec.lock
/analysis_options.yaml
